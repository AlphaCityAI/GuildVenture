# Export these through your shell or hosting environment; no .env loader is used.
TELEGRAM_TOKEN=
# Set this on the bot service. Use the existing database's current provider URL.
# Railway dashboard: reference ${{Postgres.DATABASE_URL}} (actual service name).
# Private *.railway.internal hosts require the same Railway project/environment.
# Other hosts/local shells need an explicitly authorized reachable endpoint;
# they cannot expand Railway service references. See README startup troubleshooting.
DATABASE_URL=postgresql://user:password@localhost:5432/guildventure
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4-turbo
OPENAI_IMAGE_MODEL=gpt-image-1
DEFAULT_IMAGES=true
FREE_ROLL_COOLDOWN_SECONDS=30
# Per-process admission limits; provider billing controls remain authoritative.
AI_DAILY_TEXT_LIMIT=1000
AI_DAILY_IMAGE_LIMIT=100
# Tests only: disposable database name must end in _test.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/guildventure_test
